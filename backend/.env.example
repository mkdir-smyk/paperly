# Database URL: can be local docker postgres or free tier managed postgres (Neon / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paperly

# FreeNewsApi.io key
NEWS_API_KEY=your_freenewsapi_key_here

# Allowed origins for CORS (comma-separated, or * for all)
CORS_ORIGINS=*

# JWT Authentication Secret Key (generate with `openssl rand -hex 32`)
JWT_SECRET_KEY=your_jwt_secret_key_here
